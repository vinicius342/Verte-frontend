rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Clientes ----------
    match /clientes/{clienteId} {

      // Leitura pública: qualquer pessoa, logada ou não, pode ver a lista
      allow read: if true;

      // Criação: só usuário autenticado, e createdBy/updatedBy devem
      // bater com o uid de quem está criando
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Atualização: só usuário autenticado, updatedBy deve bater com
      // quem está alterando, e createdBy nunca pode ser reescrito
      allow update: if request.auth != null
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      // Exclusão: qualquer usuário autenticado pode excluir
      allow delete: if request.auth != null;
    }

    // ---------- Usuários ----------
    match /usuarios/{userId} {

      // Cada usuário só pode ler, criar e editar o próprio documento
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // ---------- Configurações ----------
    match /configuracoes/{userId} {

      // Cada usuário só pode ler, criar e editar a própria configuração
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // ---------- Comodatos ----------
    match /comodatos/{comodatoId} {

      // Leitura: qualquer usuário autenticado pode ver a lista de comodatos
      allow read: if request.auth != null;

      // Criação: só usuário autenticado, e createdBy deve bater com
      // o uid de quem está criando
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // Sem edição nem exclusão por enquanto — comodato é um termo
      // gerado e não deve ser alterado depois de salvo
      allow update: if false;
      allow delete: if false;
    }

    // Bloqueia qualquer outra coleção não prevista
    match /{document=**} {
      allow read, write: if false;
    }
  }
}