rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Clientes: leitura pública; escrita apenas autenticada.
    match /clientes/{clienteId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.nomeCliente is string
        && request.resource.data.nomeCliente.size() > 0
        && request.resource.data.rua is string
        && request.resource.data.rua.size() > 0;

      allow update: if request.auth != null
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null;
    }

    // Usuários: cada um só acessa o próprio documento.
    match /usuarios/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
